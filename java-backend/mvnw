# ----------------------------------------------------------------------------
# Maven Wrapper startup batch script, version 3.2.0
#
# Optional ENV vars
# -----------------
#   JAVA_HOME - location of a JDK home dir, the default is "java"
#   MAVEN_OPTS - parameters passed to the Java VM when running Maven
#     e.g. to debug Maven itself, use
#       set MAVEN_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000
#   MAVEN_SKIP_RC - flag to disable loading of mavenrc files
# ----------------------------------------------------------------------------

if [ -z "$MAVEN_SKIP_RC" ] ; then
  if [ -f /etc/mavenrc ] ; then
    . /etc/mavenrc
  fi
  if [ -f "$HOME/.mavenrc" ] ; then
    . "$HOME/.mavenrc"
  fi
fi

# OS specific support.  $var _must_ be set to either true or false.
cygwin=false;
darwin=false;
mingw=false;
case "`uname`" in
  CYGWIN*) cygwin=true ;;
  Darwin*) darwin=true ;;
  MINGW*) mingw=true ;;
esac

if [ -z "$JAVA_HOME" ] ; then
  if [ -r /etc/gentoo-release ] ; then
    JAVA_HOME=`java-config --jre-home`
  fi
fi

if [ -z "$JAVA_HOME" ] ; then
  if [ -x /usr/libexec/java_home ] ; then
    JAVA_HOME=`/usr/libexec/java_home`
  fi
fi

# For Cygwin, ensure paths are in UNIX format before anything is touched
if $cygwin ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=`cygpath --unix "$JAVA_HOME"`
  [ -n "$CLASSPATH" ] && CLASSPATH=`cygpath --path --unix "$CLASSPATH"`
fi

# For Mingw, ensure paths are in UNIX format before anything is touched
if $mingw ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=`cd "$JAVA_HOME"; pwd`
fi

if [ -z "$JAVA_HOME" ] ; then
  if $darwin ; then
    if [ -x /usr/libexec/java_home ]; then
      JAVA_HOME=`/usr/libexec/java_home`
    else
      JAVA_HOME=/Library/Java/Home
    fi
  fi
fi

if [ -z "$JAVA_HOME" ] ; then
  javaExecutable="`which java`"
  if [ -z "$javaExecutable" ] ; then
    echo "Error: JAVA_HOME is not defined and no 'java' command could be found in your PATH." >&2
    exit 1
  fi
  JAVA_HOME="`dirname \"$javaExecutable\"`/.."
fi

if [ -z "$JAVACMD" ] ; then
  JAVACMD="$JAVA_HOME/bin/java"
fi

if [ ! -x "$JAVACMD" ] ; then
  echo "Error: JAVA_HOME is set to an invalid directory." >&2
  echo "JAVA_HOME = \"$JAVA_HOME\"" >&2
  echo "Please set the JAVA_HOME variable in your environment to match the" >&2
  echo "location of your Java installation." >&2
  exit 1
fi

# find the project root directory and set it as MAVEN_PROJECTBASEDIR
# this is used for the .mvn directory
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG="`dirname \"$PRG\"`/$link"
  fi
done

SAVED="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
PRG_DIR="`pwd`"
cd "$SAVED" >/dev/null

MAVEN_PROJECTBASEDIR="$PRG_DIR"
export MAVEN_PROJECTBASEDIR

# For Cygwin, switch paths to Windows format before running java
if $cygwin; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=`cygpath --path --windows "$JAVA_HOME"`
  [ -n "$MAVEN_PROJECTBASEDIR" ] && MAVEN_PROJECTBASEDIR=`cygpath --path --windows "$MAVEN_PROJECTBASEDIR"`
fi

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
LAUNCHER_CLASS="org.apache.maven.wrapper.MavenWrapperMain"

# Check if the wrapper jar exists, if not download it
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Couldn't find $WRAPPER_JAR, downloading it..."

    # Read the wrapperUrl from the properties file
    if [ -f "$WRAPPER_PROPERTIES" ]; then
        wrapperUrl=$(grep 'wrapperUrl' "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
    fi

    if [ -z "$wrapperUrl" ]; then
        wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
    fi

    # Use curl or wget to download the jar
    if command -v curl >/dev/null 2>&1; then
        curl -sfo "$WRAPPER_JAR" "$wrapperUrl"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$WRAPPER_JAR" "$wrapperUrl"
    else
        echo "Error: curl or wget is required to download the Maven Wrapper jar." >&2
        exit 1
    fi
fi

exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  $LAUNCHER_CLASS \
  "$@"
